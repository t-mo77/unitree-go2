<?xml version="1.0"?>
<!-- One box collision 0.5 x 0.4 x 0.8 at (0.1, 0, 0.4). The larger visual box must not count. -->
<sdf version="1.9">
  <model name="box_pose">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0.1 0 0.4 0 0 0</pose>
        <geometry>
          <box><size>0.5 0.4 0.8</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 1 0 0 0</pose>
        <geometry>
          <box><size>3 3 2</size></box>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
