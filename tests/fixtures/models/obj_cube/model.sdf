<?xml version="1.0"?>
<!-- The unit cube 0..1 of meshes/cube.obj scaled 2, in a link turned 90 degrees (as Fuel's Sofa turns its link),
     with the collision 0.5 m along the link x and 0.5 m down. -->
<sdf version="1.9">
  <model name="obj_cube">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 1.5707963267948966</pose>
      <collision name="collision">
        <pose>0.5 0 -0.5 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://obj_cube/meshes/cube.obj</uri>
            <scale>2 2 2</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
