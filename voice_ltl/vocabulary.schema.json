{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice_ltl/vocabulary.schema.json",
  "type": "object",
  "required": ["version", "labels"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "labels": {"type": "array", "minItems": 2, "maxItems": 200, "items": {"$ref": "#/$defs/kind"}},
    "not_words": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/word"}},
    "detect_ignore": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/prompt"}}
  },
  "$defs": {
    "kind": {
      "type": "object",
      "required": ["label", "ja", "words", "detect", "size", "height"],
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "maxLength": 24,
                  "pattern": "^(?!(?:cw|sim)(?:_|$))[a-z][a-z0-9]*(?:_[a-z][a-z0-9]*){0,3}$"},
        "ja": {"allOf": [{"$ref": "#/$defs/word"}, {"maxLength": 12}]},
        "words": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
                  "items": {"$ref": "#/$defs/word"}},
        "detect": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
                   "items": {"$ref": "#/$defs/prompt"}},
        "en": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/prompt"}},
        "size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/metres"}},
        "height": {"$ref": "#/$defs/metres"}
      }
    },
    "word": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[ぁ-ゖァ-ヺー々一-鿿]+$"},
    "prompt": {"type": "string", "pattern": "^[a-z][a-z -]{0,39}$"},
    "metres": {"type": "number", "exclusiveMinimum": 0, "maximum": 3.0}
  }
}
