# このファイルを env.txt にコピーして値を書く（env.txt は git に入れない・人に渡さない）

# LLM の切り替え：claude・codex・openrouter
LLM_BACKEND=claude
# モデル名。空なら CLI の既定のモデル
LLM_MODEL=
# Claude Code の長期トークン。Mac で `claude setup-token` を実行して出たものを自分で書く
CLAUDE_CODE_OAUTH_TOKEN=
# OpenRouter の API キー（LLM_BACKEND=openrouter のとき。LLM_MODEL も必ず書く。例：anthropic/claude-sonnet-4.5）
OPENROUTER_API_KEY=

# 書き起こし（faster-whisper）のモデルの大きさ
WHISPER_MODEL=small

# 画面（ブラウザ）のポート。空なら 8810。実機用の compose.robot.yaml ではここで決める
# （シミュレーションの compose.yaml では、シェルの環境変数か .env で渡す）
GO2_UI_PORT=

# 実機につないだ LAN の差し口の名前（例：enp3s0）。空ならコンテナのネットワークに任せる
GO2_IFACE=

# Linux直接実行の実機モードは既定でgo2（障害物判定は本体）。PCの点群判定はsensorsで診断用に使う。
# GO2_OBSTACLE_AUTHORITY=go2

# UWB リモコン追尾（run_local.sh follow）のやり方：utrack（Go2 本体の UTrack、既定）か own（このプログラムが歩かせる）
# FOLLOW_CONTROL=utrack
