# このファイルを env.txt にコピーして値を書く（env.txt は git に入れない・人に渡さない）

# LLM の切り替え：claude または codex
LLM_BACKEND=claude
# モデル名。空なら CLI の既定のモデル
LLM_MODEL=
# Claude Code の長期トークン。Mac で `claude setup-token` を実行して出たものを自分で書く
CLAUDE_CODE_OAUTH_TOKEN=

# 書き起こし（faster-whisper）のモデルの大きさ
WHISPER_MODEL=small

# 画面（ブラウザ）のポート。空なら 8810。実機用の compose.robot.yaml ではここで決める
# （シミュレーションの compose.yaml では、シェルの環境変数か .env で渡す）
GO2_UI_PORT=

# 実機につないだ LAN の差し口の名前（例：enp3s0）。空ならコンテナのネットワークに任せる
GO2_IFACE=
