+++ b/controllers/unitree_guide_controller/src/gait/FeetEndCalc.cpp
@@ -20,7 +20,11 @@ void FeetEndCalc::init() {
     t_stance_ = ctrl_component_.wave_generator_->get_t_stance();
     t_swing_ = ctrl_component_.wave_generator_->get_t_swing();
 
-    Vec34 feet_pos_body = estimator_->getFeetPos2Body();
+    // feet_init_angle_ must be a body-frame angle: calcFootPos() adds the current yaw to it.
+    // getFeetPos2Body() is world-frame (R * p_b), so entering trotting at yaw psi0 != 0 would
+    // place every foot psi0 too far round the body (unitree_guide uses the ideal body-frame
+    // stance here).
+    const Vec34 feet_pos_body = estimator_->getRotation().transpose() * estimator_->getFeetPos2Body();
     // Vec34 feet_pos_body = robot_model_.feet_pos_normal_stand_;
