+        const Vec3 v_b(foot_vels_[i].data);
+        feet_pos_body_.segment(3 * i, 3) = rotation_ * p_b;
+        feet_vel_body_.segment(3 * i, 3) = rotation_ * (v_b + skew(gyro_) * p_b);
+    }
