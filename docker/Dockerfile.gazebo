# Image for the `gazebo` service: go2-voice-ltl-gazebo:dev
# Gazebo Classic 11 + legubiao/quadruped_ros2_control (unitree_guide controller, Go2 model).
# Gazebo's screen runs on a virtual display (Xvfb :1) and is seen in the browser through
# noVNC (http://localhost:6080/vnc.html). Docker on a Mac has no GPU, so OpenGL is
# drawn in software.
# Build the shared image first: docker compose build app
FROM go2-voice-ltl:dev

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# Pinned commit of the humble branch (checked on 2026-11-04)
ARG QUADRUPED_ROS2_CONTROL_COMMIT=a808acbd0bdb9d298d07de3c954010e3d57a15f6

# Gazebo Classic, ros2_control and the virtual screen.
# rviz2: the upstream gazebo_classic.launch.py starts it.
# ros2controlcli: `ros2 control list_controllers`.
# feh: without a wallpaper setter, fluxbox shows a "can't find an app to set the
#      wallpaper" window in the middle of the screen.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-humble-gazebo-ros-pkgs \
        ros-humble-gazebo-ros2-control \
        ros-humble-ros2-controllers \
        ros-humble-xacro \
        ros-humble-rviz2 \
        ros-humble-ros2controlcli \
        xvfb \
        fluxbox \
        feh \
        x11vnc \
        novnc \
        websockify \
        mesa-utils \
    && rm -rf /var/lib/apt/lists/*

RUN git clone -b humble https://github.com/legubiao/quadruped_ros2_control \
        /root/gz_ws/src/quadruped_ros2_control \
    && cd /root/gz_ws/src/quadruped_ros2_control \
    && git checkout "${QUADRUPED_ROS2_CONTROL_COMMIT}"

WORKDIR /root/gz_ws
RUN apt-get update \
    && rosdep update --rosdistro humble \
    && rosdep install --from-paths src --ignore-src -r -y \
    && rm -rf /var/lib/apt/lists/*

# leg_pd_controller: Gazebo Classic only gives joint effort; this controller turns the
# position/velocity/kp/kd commands of unitree_guide controller into effort (upstream README 1.2).
RUN source /opt/ros/humble/setup.bash \
    && MAKEFLAGS=-j4 colcon build --parallel-workers 2 \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
        --packages-up-to unitree_guide_controller go2_description keyboard_input leg_pd_controller \
    && rm -rf build log

ENV LIBGL_ALWAYS_SOFTWARE=1
ENV DISPLAY=:1

COPY gazebo_entry.sh /usr/local/bin/gazebo_entry.sh
RUN chmod 755 /usr/local/bin/gazebo_entry.sh

EXPOSE 6080
WORKDIR /work

ENTRYPOINT ["/usr/local/bin/gazebo_entry.sh"]
CMD ["ros2", "launch", "unitree_guide_controller", "gazebo_classic.launch.py", "pkg_description:=go2_description"]
